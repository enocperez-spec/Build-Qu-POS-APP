<!--
============================================================
Qu App HTA Launcher
Purpose: Windows HTML launcher for the QU App PowerShell tool
Version: 3.0
Created by William Cralle and Enoc Perez
For any changes, please reach out to us.
============================================================
-->
<html>
<head>
    <title>Build QU POS APP HTML TOOL</title>
    <hta:application
        applicationname="Build QU POS APP HTML TOOL"
        border="thin"
        caption="yes"
        maximizebutton="no"
        minimizebutton="yes"
        showintaskbar="yes"
        singleinstance="yes"
        sysmenu="yes"
        scroll="yes"
        selection="no"
        windowstate="normal" />
    <style>
        body {
            margin: 0;
            font-family: Segoe UI, Arial, sans-serif;
            background: #0f172a;
            color: #e2e8f0;
        }
        .shell {
            width: 900px;
            margin: 0 auto;
            padding: 28px;
        }
        .header {
            position: relative;
            min-height: 94px;
            margin-bottom: 22px;
        }
        .header img {
            position: absolute;
            left: 0;
            top: 0;
            width: 88px;
            height: auto;
        }
        .header-copy {
            margin-left: 110px;
            padding-top: 0;
        }
        .header h1 {
            margin: 0 0 8px;
            color: #38bdf8;
            font-size: 28px;
            line-height: 1.05;
        }
        .header p {
            margin: 4px 0 0;
            color: #cbd5e1;
        }
        .card {
            background: #111827;
            border: 1px solid #334155;
            border-radius: 12px;
            padding: 18px;
            margin-bottom: 18px;
        }
        .section-title {
            margin: 0 0 14px;
            color: #facc15;
            font-size: 18px;
        }
        .field {
            margin-bottom: 22px;
        }
        .field label {
            display: block;
            margin-bottom: 6px;
            color: #93c5fd;
            font-size: 13px;
            font-weight: bold;
        }
        .field-row {
            margin-top: 10px;
            white-space: nowrap;
        }
        .field-row input[type="text"] {
            display: inline-block;
            width: 500px;
            margin-right: 0;
            vertical-align: middle;
        }
        .field-row button {
            display: inline-block;
            width: 200px;
            vertical-align: middle;
            margin-left: 26px;
        }
        input[type="text"] {
            width: 100%;
            box-sizing: border-box;
            padding: 13px 14px;
            border-radius: 10px;
            border: 1px solid #334155;
            background: #0b1220;
            color: #f8fafc;
            outline: none;
        }
        input[type="checkbox"] {
            vertical-align: middle;
            margin-right: 8px;
        }
        .inline-note {
            color: #94a3b8;
            font-size: 12px;
            margin-top: 10px;
        }
        .button-row {
            margin-top: 34px;
            padding-top: 12px;
        }
        button {
            border: 1px solid #f8fafc;
            background: #111827;
            color: #f8fafc;
            padding: 12px 20px;
            border-radius: 999px;
            cursor: pointer;
            font-weight: bold;
            box-shadow: 0 0 0 1px rgba(248, 250, 252, 0.22), 0 8px 18px rgba(15, 23, 42, 0.38);
            margin-top: 4px;
            margin-right: 18px;
            margin-bottom: 12px;
        }
        .button-row button {
            display: inline-block;
            width: 230px;
            vertical-align: top;
            margin-right: 26px;
        }
        .button-row button:last-child {
            margin-right: 0;
        }
        button:hover {
            background: #172033;
            box-shadow: 0 0 0 2px rgba(248, 250, 252, 0.28), 0 10px 20px rgba(15, 23, 42, 0.45);
        }
        button.primary {
            background: #082f49;
            border-color: #f8fafc;
            box-shadow: 0 0 0 1px rgba(248, 250, 252, 0.28), 0 10px 22px rgba(8, 47, 73, 0.45);
        }
        button.primary:hover {
            background: #0c4368;
        }
        button:disabled {
            opacity: 0.55;
            cursor: default;
            box-shadow: 0 0 0 1px rgba(248, 250, 252, 0.12);
        }
        .status-box {
            width: 100%;
            height: 170px;
            box-sizing: border-box;
            border-radius: 12px;
            border: 1px solid #334155;
            background: #0b1220;
            color: #e2e8f0;
            padding: 12px;
            font-family: Consolas, monospace;
            resize: none;
        }
        .summary {
            margin-top: 12px;
            color: #cbd5e1;
            line-height: 1.5;
        }
        .summary strong {
            color: #f8fafc;
        }
        .footer {
            color: #94a3b8;
            font-size: 12px;
            margin-top: 14px;
        }
        .hidden-picker {
            position: absolute;
            left: -9999px;
            width: 1px;
            height: 1px;
            overflow: hidden;
        }
    </style>
    <script language="javascript">
      var toolVersion = "3.0";
        var currentGenerateActive = false;
        var currentProgressFile = "";
        var currentProgressLength = 0;
        var lastGeneratedOutputPath = "";
        var currentGenerateStartTime = 0;
        var currentGenerateDidComplete = false;
        var currentGenerateDidFail = false;
        var currentGenerateFailureMessage = "";
        var currentGenerateWaitLogged = false;

        function trimValue(value) {
            return String(value || "").replace(/^\s+|\s+$/g, "");
        }

        function getLauncherFolder() {
            var path = decodeURIComponent(location.pathname).replace(/\//g, "\\");
            if (/^\\[A-Za-z]:\\/.test(path)) {
                path = path.substring(1);
            }
            return path.substring(0, path.lastIndexOf("\\"));
        }

        function getAppDataFolder() {
            return combinePath(getLauncherFolder(), "AppData");
        }

        function combinePath(left, right) {
            if (!left) {
                return right;
            }
            if (/[\\\/]$/.test(left)) {
                return left + right;
            }
            return left + "\\" + right;
        }

        function getScriptPath() {
            return combinePath(getAppDataFolder(), "Qu_App.ps1");
        }

        function getDefaultOutputPath() {
            return combinePath(getAppDataFolder(), "QuPOS_CurrentVersions.html");
        }

        function getProgressFilePath() {
            return combinePath(getAppDataFolder(), "_qu_app_progress.log");
        }

        function toFileUrl(pathValue) {
            return "file:///" + String(pathValue || "").replace(/\\/g, "/");
        }

        function findAppLogoPath() {
            var appDataFolder = getAppDataFolder();
            var preferredPath = combinePath(appDataFolder, "GoTo Foods White LOGO.png");
            try {
                var fso = new ActiveXObject("Scripting.FileSystemObject");
                if (fso.FileExists(preferredPath)) {
                    return preferredPath;
                }
                if (!fso.FolderExists(appDataFolder)) {
                    return preferredPath;
                }
                var files = new Enumerator(fso.GetFolder(appDataFolder).Files);
                var fallbackPath = "";
                for (; !files.atEnd(); files.moveNext()) {
                    var file = files.item();
                    var name = String(file.Name || "");
                    if (!/\.(png|jpg|jpeg|gif|svg)$/i.test(name)) {
                        continue;
                    }
                    if (/(?:goto.*logo|logo.*goto)/i.test(name)) {
                        return file.Path;
                    }
                    if (!fallbackPath && /logo/i.test(name)) {
                        fallbackPath = file.Path;
                    }
                }
                return fallbackPath || preferredPath;
            } catch (error) {
                return preferredPath;
            }
        }

        function getValue(id) {
            return trimValue(document.getElementById(id).value);
        }

        function setValue(id, value) {
            document.getElementById(id).value = value;
        }

        function quoteArgument(value) {
            return "\"" + String(value || "").replace(/"/g, "\\\"") + "\"";
        }

        function getInitialDirectory(pathValue) {
            var cleanPath = trimValue(pathValue);
            if (!cleanPath) {
                return getAppDataFolder();
            }
            var separatorIndex = Math.max(cleanPath.lastIndexOf("\\"), cleanPath.lastIndexOf("/"));
            if (separatorIndex < 0) {
                return getAppDataFolder();
            }
            return cleanPath.substring(0, separatorIndex);
        }

        function appendStatus(message) {
            var box = document.getElementById("statusBox");
            var now = new Date();
            var hours = now.getHours();
            var minutes = now.getMinutes();
            var seconds = now.getSeconds();
            var suffix = hours >= 12 ? "PM" : "AM";
            var displayHour = hours % 12;
            if (displayHour === 0) {
                displayHour = 12;
            }
            var stamp = "[" +
                ("0" + displayHour).slice(-2) + ":" +
                ("0" + minutes).slice(-2) + ":" +
                ("0" + seconds).slice(-2) + " " + suffix + "] ";
            box.value += stamp + message + "\r\n";
            box.scrollTop = box.scrollHeight;
        }

        function setBusy(isBusy, summaryText) {
            document.getElementById("generateButton").disabled = isBusy;
            document.getElementById("openUiButton").disabled = isBusy;
            document.getElementById("openReportButton").disabled = isBusy;
            document.body.style.cursor = isBusy ? "wait" : "default";
            if (summaryText) {
                document.getElementById("summaryText").innerText = summaryText;
            }
        }

        function ensureOutputPath() {
            if (!getValue("outputPath")) {
                setValue("outputPath", getDefaultOutputPath());
            }
        }

        function getFileName(pathValue) {
            var cleanPath = trimValue(pathValue);
            var separatorIndex = Math.max(cleanPath.lastIndexOf("\\"), cleanPath.lastIndexOf("/"));
            if (separatorIndex < 0) {
                return cleanPath;
            }
            return cleanPath.substring(separatorIndex + 1);
        }

        function getDirectoryName(pathValue) {
            var cleanPath = trimValue(pathValue);
            var separatorIndex = Math.max(cleanPath.lastIndexOf("\\"), cleanPath.lastIndexOf("/"));
            if (separatorIndex < 0) {
                return "";
            }
            return cleanPath.substring(0, separatorIndex);
        }

        function getDateFolderName() {
            var now = new Date();
            return now.getFullYear() + "-" +
                ("0" + (now.getMonth() + 1)).slice(-2) + "-" +
                ("0" + now.getDate()).slice(-2);
        }

        function getEffectiveOutputPath() {
            var baseOutputPath = getValue("outputPath") || getDefaultOutputPath();
            if (!document.getElementById("timestampedOutput").checked) {
                return baseOutputPath;
            }

            var outputFileName = getFileName(baseOutputPath);
            var outputDirectory = getDirectoryName(baseOutputPath);
            var directoryLeaf = getFileName(outputDirectory);
            var reportsParent = getDirectoryName(outputDirectory);
            var baseDirectory = outputDirectory;

            if (/^\d{4}-\d{2}-\d{2}$/.test(directoryLeaf) && getFileName(reportsParent).toLowerCase() === "reports") {
                baseDirectory = getDirectoryName(reportsParent);
            }

            return combinePath(combinePath(combinePath(baseDirectory, "Reports"), getDateFolderName()), outputFileName);
        }

        function browseCsv(targetId, pickerId) {
            try {
                document.getElementById(pickerId).click();
            } catch (error) {
                alert("The CSV picker could not be opened. You can still paste the path into the field manually.");
            }
        }

        function syncPickedFile(targetId, picker) {
            if (!picker || !picker.value) {
                return;
            }
            setValue(targetId, picker.value);
            if (targetId === "csvPath" && !getValue("outputPath")) {
                ensureOutputPath();
            }
            appendStatus("Selected: " + picker.value);
        }

        function browseOutputFolder() {
            try {
                var shellApp = new ActiveXObject("Shell.Application");
                var folder = shellApp.BrowseForFolder(0, "Select the folder where the HTML report should be saved.", 0);
                if (folder && folder.Self && folder.Self.Path) {
                    var currentOutput = getValue("outputPath");
                    var outputName = getFileName(currentOutput) || "QuPOS_CurrentVersions.html";
                    var outputPath = combinePath(folder.Self.Path, outputName);
                    setValue("outputPath", outputPath);
                    appendStatus("Output folder selected: " + folder.Self.Path);
                }
            } catch (error) {
                alert("The output folder picker is not available on this machine. You can still type or paste the output HTML path manually.");
            }
        }

        function fileExists(pathValue) {
            try {
                var fso = new ActiveXObject("Scripting.FileSystemObject");
                return fso.FileExists(pathValue);
            } catch (error) {
                return false;
            }
        }

        function deleteFileIfExists(pathValue) {
            try {
                var fso = new ActiveXObject("Scripting.FileSystemObject");
                if (fso.FileExists(pathValue)) {
                    fso.DeleteFile(pathValue, true);
                }
            } catch (error) {
            }
        }

        function readTextFile(pathValue) {
            try {
                var fso = new ActiveXObject("Scripting.FileSystemObject");
                if (!fso.FileExists(pathValue)) {
                    return "";
                }
                var stream = fso.OpenTextFile(pathValue, 1, false);
                var content = stream.ReadAll();
                stream.Close();
                return content;
            } catch (error) {
                return "";
            }
        }

        function setProgressText(message) {
            document.getElementById("progressText").innerText = message;
        }

        function handleProgressLine(line) {
            var cleanLine = trimValue(line);
            if (!cleanLine) {
                return;
            }
            appendStatus(cleanLine);
            if (/^Loading CSV$/i.test(cleanLine)) {
                setProgressText("Progress: Loading CSV");
            } else if (/^Loading comparison CSV$/i.test(cleanLine)) {
                setProgressText("Progress: Loading comparison CSV");
            } else if (/^Building report$/i.test(cleanLine)) {
                setProgressText("Progress: Building report");
            } else if (/^Building alerts$/i.test(cleanLine)) {
                setProgressText("Progress: Building alerts");
            } else if (/^Writing HTML$/i.test(cleanLine)) {
                setProgressText("Progress: Writing HTML");
            } else if (/^Done$/i.test(cleanLine)) {
                currentGenerateDidComplete = true;
                setProgressText("Progress: Done");
            } else if (/^Error:/i.test(cleanLine)) {
                currentGenerateDidFail = true;
                currentGenerateFailureMessage = cleanLine;
                setProgressText("Progress: Error");
            }
        }

        function readProgressUpdates() {
            if (!currentProgressFile) {
                return;
            }
            var content = readTextFile(currentProgressFile);
            if (!content || content.length <= currentProgressLength) {
                return;
            }
            var newContent = content.substring(currentProgressLength);
            currentProgressLength = content.length;
            var lines = newContent.replace(/\r/g, "").split("\n");
            for (var i = 0; i < lines.length; i += 1) {
                handleProgressLine(lines[i]);
            }
        }

        function buildGenerateCommand() {
            var csvPath = getValue("csvPath");
            var previousCsvPath = getValue("previousCsvPath");
            var outputPath = getValue("outputPath");
            var command = "powershell.exe -WindowStyle Hidden -NoProfile -ExecutionPolicy Bypass -File " +
                quoteArgument(getScriptPath()) +
                " -CsvPath " + quoteArgument(csvPath) +
                " -OutputFile " + quoteArgument(outputPath);

            if (previousCsvPath) {
                command += " -PreviousCsvPath " + quoteArgument(previousCsvPath);
            }
            if (document.getElementById("timestampedOutput").checked) {
                command += " -TimestampedOutput";
            }
            command += " -ProgressFile " + quoteArgument(getProgressFilePath());
            if (!document.getElementById("openAfterGenerate").checked) {
                command += " -SkipOpen";
            }
            return command;
        }

        function pollGenerateProgress() {
            if (!currentGenerateActive) {
                return;
            }

            readProgressUpdates();
            if (currentGenerateDidComplete) {
                setProgressText("Progress: Done");
                document.getElementById("openReportButton").disabled = false;
                document.getElementById("summaryText").innerText = "Report created successfully at " + lastGeneratedOutputPath;
                appendStatus("Report path: " + lastGeneratedOutputPath);
                currentGenerateActive = false;
                setBusy(false);
                return;
            }

            if (currentGenerateDidFail) {
                setProgressText("Progress: Failed");
                appendStatus(currentGenerateFailureMessage || "Generation finished with an error.");
                document.getElementById("summaryText").innerText = "Generation finished with an error. Review the status log and try again.";
                alert(currentGenerateFailureMessage || "Generation finished with an error.");
                currentGenerateActive = false;
                setBusy(false);
                return;
            }

            if ((new Date().getTime() - currentGenerateStartTime) > 3600000) {
                setProgressText("Progress: Timed out");
                appendStatus("Generation timed out after 60 minutes.");
                document.getElementById("summaryText").innerText = "Generation timed out. Review the status log and try again.";
                currentGenerateActive = false;
                setBusy(false);
                return;
            }

            if (fileExists(lastGeneratedOutputPath) && currentProgressLength > 0) {
                window.setTimeout(pollGenerateProgress, 250);
                return;
            }

            if (!currentGenerateWaitLogged && !fileExists(currentProgressFile) && (new Date().getTime() - currentGenerateStartTime) > 5000) {
                appendStatus("Waiting for PowerShell progress log...");
                currentGenerateWaitLogged = true;
            }
            window.setTimeout(pollGenerateProgress, 250);
        }

        function generateHtml() {
            var csvPath = getValue("csvPath");
            var previousCsvPath = getValue("previousCsvPath");
            ensureOutputPath();
            var outputPath = getValue("outputPath");
            var effectiveOutputPath = getEffectiveOutputPath();
            var scriptPath = getScriptPath();

            if (!csvPath) {
                alert("Select or enter the current terminal CSV path.");
                return;
            }
            if (!fileExists(scriptPath)) {
                alert("Qu_App.ps1 was not found beside this HTA.\r\n\r\nExpected path:\r\n" + scriptPath);
                return;
            }
            if (!fileExists(csvPath)) {
                alert("The current CSV file was not found.\r\n\r\n" + csvPath);
                return;
            }
            if (previousCsvPath && !fileExists(previousCsvPath)) {
                alert("The previous CSV file was not found.\r\n\r\n" + previousCsvPath);
                return;
            }
            if (!outputPath) {
                alert("Enter an output HTML path.");
                return;
            }

            deleteFileIfExists(getProgressFilePath());
            currentProgressFile = getProgressFilePath();
            currentProgressLength = 0;
            lastGeneratedOutputPath = effectiveOutputPath;
            currentGenerateStartTime = new Date().getTime();
            currentGenerateDidComplete = false;
            currentGenerateDidFail = false;
            currentGenerateFailureMessage = "";
            currentGenerateWaitLogged = false;
            currentGenerateActive = true;
            setBusy(true, "Generating HTML report...");
            setProgressText("Progress: Starting...");
            document.getElementById("openReportButton").disabled = true;
            appendStatus("Starting HTML generation.");
            appendStatus("Current CSV: " + csvPath);
            if (previousCsvPath) {
                appendStatus("Previous CSV: " + previousCsvPath);
            }
            if (document.getElementById("timestampedOutput").checked) {
                appendStatus("Timestamped output enabled.");
            }
            appendStatus("Output HTML: " + effectiveOutputPath);

            window.setTimeout(function () {
                try {
                    var shell = new ActiveXObject("WScript.Shell");
                    shell.Run(buildGenerateCommand(), 0, false);
                    pollGenerateProgress();
                } catch (error) {
                    setProgressText("Progress: Error");
                    appendStatus("Error: " + error.message);
                    document.getElementById("summaryText").innerText = "Generation failed. Review the input paths and try again.";
                    alert(error.message);
                    currentGenerateActive = false;
                    setBusy(false);
                }
            }, 50);
        }

        function openPowerShellUi() {
            var scriptPath = getScriptPath();
            if (!fileExists(scriptPath)) {
                alert("Qu_App.ps1 was not found beside this HTA.\r\n\r\nExpected path:\r\n" + scriptPath);
                return;
            }

            try {
                var shell = new ActiveXObject("WScript.Shell");
                var command = "powershell.exe -WindowStyle Hidden -NoProfile -ExecutionPolicy Bypass -File " +
                    quoteArgument(scriptPath) + " -ShowUi";
                if (document.getElementById("timestampedOutput").checked) {
                    command += " -TimestampedOutput";
                }
                shell.Run(command, 0, false);
                appendStatus("Opened the PowerShell UI.");
            } catch (error) {
                appendStatus("Error: " + error.message);
                alert(error.message);
            }
        }

        function openReport() {
            var outputPath = lastGeneratedOutputPath || getEffectiveOutputPath();
            if (!fileExists(outputPath)) {
                alert("The HTML report does not exist yet.\r\n\r\n" + outputPath);
                return;
            }

            try {
                var shell = new ActiveXObject("WScript.Shell");
                shell.Run(quoteArgument(outputPath), 1, false);
                appendStatus("Opened report: " + outputPath);
            } catch (error) {
                appendStatus("Error: " + error.message);
                alert(error.message);
            }
        }

        function initialize() {
            window.resizeTo(1040, 920);
            document.title = "Build QU POS APP HTML TOOL v" + toolVersion;
            document.getElementById("versionText").innerText = "Version " + toolVersion;
            document.getElementById("scriptPathText").innerText = getScriptPath();
            var logoPath = findAppLogoPath();
            var headerLogo = document.getElementById("appLogo");
            if (headerLogo) {
                headerLogo.src = toFileUrl(logoPath);
            }
            document.body.style.overflow = "auto";
            setProgressText("Progress: Ready");
            ensureOutputPath();
            appendStatus("HTA launcher ready.");
            appendStatus("AppData folder: " + getAppDataFolder());
            appendStatus("PowerShell script: " + getScriptPath());
            appendStatus("Logo path: " + logoPath);
        }
    </script>
</head>
<body onload="initialize();">
    <div class="shell">
        <div class="header">
            <img id="appLogo" src="" alt="GoTo Foods logo" />
            <div class="header-copy">
                <h1>Build QU POS APP HTML TOOL</h1>
                <p>Generate The QU POS HTML Report.</p>
                <p id="versionText">Version 3.0</p>
            </div>
        </div>

        <div class="card">
            <h2 class="section-title">Report Inputs</h2>

            <div class="field">
                <label for="csvPath">Current Terminal CSV</label>
                <div class="field-row">
                    <input id="csvPath" type="text" />
                    <button type="button" onclick="browseCsv('csvPath', 'csvPicker');">Browse CSV</button>
                </div>
                <input id="csvPicker" class="hidden-picker" type="file" accept=".csv" onchange="syncPickedFile('csvPath', this);" />
            </div>

            <div class="field">
                <label for="previousCsvPath">Previous CSV (Optional)</label>
                <div class="field-row">
                    <input id="previousCsvPath" type="text" />
                    <button type="button" onclick="browseCsv('previousCsvPath', 'previousCsvPicker');">Browse CSV</button>
                </div>
                <input id="previousCsvPicker" class="hidden-picker" type="file" accept=".csv" onchange="syncPickedFile('previousCsvPath', this);" />
            </div>

            <div class="field">
                <label for="outputPath">Output HTML</label>
                <div class="field-row">
                    <input id="outputPath" type="text" />
                    <button type="button" onclick="browseOutputFolder();">Browse Folder</button>
                </div>
                <div class="inline-note">Choose a folder and the launcher will keep the current HTML filename, or type the full output path manually.</div>
            </div>

            <div class="field">
                <label><input id="openAfterGenerate" type="checkbox" checked="checked" />Open HTML after generate</label>
            </div>

            <div class="field">
                <label><input id="timestampedOutput" type="checkbox" />Save in Reports\YYYY-MM-DD folder</label>
            </div>

            <div class="button-row">
                <button id="generateButton" class="primary" type="button" onclick="generateHtml();">Generate HTML</button>
                <button id="openUiButton" type="button" onclick="openPowerShellUi();">Open PowerShell UI</button>
                <button id="openReportButton" type="button" onclick="openReport();" disabled="disabled">Open Report</button>
            </div>
        </div>

        <div class="card">
            <h2 class="section-title">Status</h2>
            <div id="summaryText" class="summary">
                <strong>Ready.</strong> Use this launcher to run the same PowerShell report workflow without opening the script manually.
            </div>
            <div id="progressText" class="footer">Progress: Ready</div>
            <div class="footer">PowerShell script path: <span id="scriptPathText"></span></div>
            <div style="height: 12px;"></div>
            <textarea id="statusBox" class="status-box" readonly="readonly"></textarea>
        </div>
    </div>
</body>
</html>


